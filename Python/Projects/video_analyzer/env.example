# Gemini API Configuration
# Get your API key from: https://ai.google.dev/gemini-api
GOOGLE_API_KEY=your_api_key_here

# Model to use for video analysis
# Supported models: gemini-2.0-flash, gemini-1.5-pro, gemini-1.5-flash
GEMINI_MODEL=gemini-2.0-flash

# Default prompt for video analysis
GEMINI_PROMPT=Describe what is happening in this video in detail.

# Application Settings
# Maximum video file size in megabytes
MAX_VIDEO_SIZE_MB=100

# API request timeout in seconds
API_TIMEOUT=30.0

# Polling interval for file processing status (seconds)
FILE_PROCESSING_POLL_INTERVAL=2.0

# Maximum number of retries for API calls
MAX_API_RETRIES=3