# OpenRouter API Configuration
# Get your API key from: https://openrouter.ai/keys
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model to use for video analysis (OpenRouter model ID)
# Example: anthropic/claude-3.5-sonnet, openai/gpt-4o, google/gemini-2.0-flash-1.5
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Google Gemini API Configuration (alternative provider)
# Get your API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Default prompt for video analysis
OPENROUTER_PROMPT=Describe what is happening in this video in detail.

# Application Settings
# Maximum video file size in megabytes
MAX_VIDEO_SIZE_MB=100

# API request timeout in seconds
API_TIMEOUT=30.0

# Polling interval for file processing status (seconds)
FILE_PROCESSING_POLL_INTERVAL=2.0

# Maximum number of retries for API calls
MAX_API_RETRIES=3